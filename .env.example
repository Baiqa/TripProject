# Скопируйте в .env.local и заполните значениями локального `supabase start`
# (см. вывод команды) или вашего облачного проекта Supabase.
# Файл .env.local в git не попадает (см. .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только для серверного кода (route handlers, RPC от имени сервиса).
# Никогда не должен попадать в NEXT_PUBLIC_* или клиентский бандл.
SUPABASE_SERVICE_ROLE_KEY=
